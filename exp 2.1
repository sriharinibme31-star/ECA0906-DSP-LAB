clc;
clear;
close all;

% EX NO: 2.1
% Chebyshev Type-I IIR Low-Pass Filter

Wp = 0.4;       % Passband edge frequency (normalized)
Ws = 0.55;      % Stopband edge frequency (normalized)
Rp = 1;         % Passband ripple (dB)
As = 40;        % Stopband attenuation (dB)

% Calculate minimum filter order and cutoff frequency
[N,Wn] = cheb1ord(Wp,Ws,Rp,As);

% Design Chebyshev Type-I Low-Pass Filter
[b,a] = cheby1(N,Rp,Wn);

% Display filter parameters
fprintf('Filter Order = %d\n',N);
fprintf('Cutoff Frequency = %.2f * pi rad/sample\n',Wn);

% Stability check
poles = roots(a);

if all(abs(poles) < 1)
    disp('System is STABLE');
else
    disp('System is UNSTABLE');
end

% -------- GRAPHS --------

% Magnitude and Phase Response
figure;
freqz(b,a);
title('Magnitude and Phase Response');

% Impulse Response
figure;
impz(b,a);
title('Impulse Response');

% Group Delay
figure;
grpdelay(b,a);
title('Group Delay');

% Pole-Zero Plot
figure;
zplane(b,a);
title('Pole-Zero Plot');
