clc;
clear;
close all;

% Sample index
n = 0:79;

% Original sinusoidal signal
x = sin(2*pi*n/40);

% Quantization factor
q = 8;

% Truncation quantization
xt = floor(x*q)/q;

% Rounding quantization
xr = round(x*q)/q;

% Quantization errors
et = x - xt;
er = x - xr;

% Calculate Mean Squared Error
mse_t = mean(et.^2);
mse_r = mean(er.^2);

%% Figure 1: Original vs Quantized
figure;
plot(n, x, 'b-', 'LineWidth', 1.5);
hold on;
plot(n, xr, 'r--', 'LineWidth', 1.5);
grid on;

title('Original vs Quantized Signal');
xlabel('Sample Number');
ylabel('Amplitude');
legend('Original Signal', 'Quantized Signal');

%% Figure 2: Truncation vs Rounding
figure;
plot(n, x, 'b-', 'LineWidth', 1.5);
hold on;
plot(n, xt, 'r--', 'LineWidth', 1.5);
plot(n, xr, 'g-.', 'LineWidth', 1.5);
grid on;

title('Truncation vs Rounding');
xlabel('Sample Number');
ylabel('Amplitude');
legend('Original', 'Truncated', 'Rounded');

%% Figure 3: Quantization Error
figure;
stem(n, et, 'r', 'filled');
hold on;
stem(n, er, 'g', 'filled');
grid on;

title('Quantization Error');
xlabel('Sample Number');
ylabel('Error');
legend('Truncation Error', 'Rounding Error');

%% Figure 4: MSE Comparison
figure;
bar([mse_t mse_r]);

set(gca, 'XTick', 1:2);
set(gca, 'XTickLabel', {'Truncation', 'Rounding'});

grid on;
title('MSE Comparison');
ylabel('Mean Squared Error');

% Display MSE values in Command Window
fprintf('Truncation MSE = %.6f\n', mse_t);
fprintf('Rounding MSE   = %.6f\n', mse_r);
