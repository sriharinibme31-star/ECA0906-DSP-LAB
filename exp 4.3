clc;
clear;
close all;

%% --- Input Parameters ---
fp = 1000;          % Passband cutoff frequency (Hz)
Fs = 4000;          % Sampling frequency (Hz)
N  = 50;            % Filter order

% Normalized cutoff frequency
wc = fp / (Fs/2);

%% --- FIR Low-Pass Filter using Hanning Window ---
b_hann = fir1(N, wc, 'low', hanning(N+1));

%% --- Display Hanning Window Coefficients ---
disp('--- Hanning Window FIR Filter Coefficients ---');
disp(b_hann');

%% --- Plot Frequency Response ---
figure;
freqz(b_hann, 1, 2048, Fs);
title('Low-Pass FIR Filter using Hanning Window');
grid on;

%% --- Plot Impulse Response ---
figure;
stem(0:N, b_hann, 'filled');
grid on;
xlabel('Sample');
ylabel('Amplitude');
title('Impulse Response of Hanning Window FIR Filter');

%% --- Display Filter Specifications ---
fprintf('\n--- Filter Specifications ---\n');
fprintf('Sampling Frequency     = %d Hz\n', Fs);
fprintf('Cutoff Frequency       = %d Hz\n', fp);
fprintf('Filter Order           = %d\n', N);
fprintf('Number of Coefficients = %d\n', N+1);
fprintf('Normalized Cutoff     = %.2f\n', wc);
