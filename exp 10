clc;
clear;
close all;

%% Sampling Parameters
Fs = 8000;
t = 0:1/Fs:3;

%% Clean Speech Signal
x = sin(2*pi*200*t) + 0.5*sin(2*pi*400*t);

%% Add Noise
noise = 0.3 * randn(size(x));
xn = x + noise;

%% Spectral Subtraction
Y = fft(xn);
N = fft(noise);

% Estimate enhanced magnitude spectrum
Xe_mag = max(abs(Y) - abs(N), 0);

% Combine enhanced magnitude with noisy phase
Xe = Xe_mag .* exp(1j * angle(Y));

% Convert back to time domain
xe = real(ifft(Xe));

%% Figure 1: Time Domain Signals
figure;

subplot(3,1,1);
plot(t, x);
title('Clean Speech Signal');
xlabel('Time (s)');
ylabel('Amplitude');
grid on;

subplot(3,1,2);
plot(t, xn);
title('Noisy Speech Signal');
xlabel('Time (s)');
ylabel('Amplitude');
grid on;

subplot(3,1,3);
plot(t, xe);
title('Enhanced Speech Signal');
xlabel('Time (s)');
ylabel('Amplitude');
grid on;

%% Figure 2: Spectrograms
figure;

subplot(3,1,1);
spectrogram(x, 256, 128, 256, Fs, 'yaxis');
title('Clean Spectrogram');

subplot(3,1,2);
spectrogram(xn, 256, 128, 256, Fs, 'yaxis');
title('Noisy Spectrogram');

subplot(3,1,3);
spectrogram(xe, 256, 128, 256, Fs, 'yaxis');
title('Enhanced Spectrogram');

%% Figure 3: Magnitude Spectra
X = fft(x);
XN = fft(xn);
XE = fft(xe);

NFFT = length(x);
f = (0:NFFT-1) * Fs / NFFT;

figure;

subplot(3,1,1);
plot(f(1:NFFT/2), abs(X(1:NFFT/2)));
title('Clean Spectrum');
xlabel('Frequency (Hz)');
ylabel('Magnitude');
grid on;

subplot(3,1,2);
plot(f(1:NFFT/2), abs(XN(1:NFFT/2)));
title('Noisy Spectrum');
xlabel('Frequency (Hz)');
ylabel('Magnitude');
grid on;

subplot(3,1,3);
plot(f(1:NFFT/2), abs(XE(1:NFFT/2)));
title('Enhanced Spectrum');
xlabel('Frequency (Hz)');
ylabel('Magnitude');
grid on;

%% Display Result
disp('-----------------------------------------');
disp('SPEECH ENHANCEMENT USING SPECTRAL SUBTRACTION');
disp('-----------------------------------------');
disp('Clean speech signal generated successfully.');
disp('Noise added successfully.');
disp('Spectral subtraction applied successfully.');
disp('Enhanced speech signal obtained.');
